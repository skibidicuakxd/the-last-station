---
import { film } from '../content/film';
import MediaPlaceholder from './MediaPlaceholder.astro';
---

<section class="cast section" id="reparto" aria-labelledby="cast-title">
  <div class="container">
    <header class="section-head cast__head">
      <div class="cast__head-main">
        <p class="eyebrow">
          <span class="eyebrow__num">02</span>
          <span>/</span>
          <span>Reparto</span>
          <span class="eyebrow__rule"></span>
        </p>
        <h2 class="section-title" id="cast-title">{film.labels.sectionCast}</h2>
      </div>
      <p class="cast__count mono">
        <span class="amber">{String(film.cast.length).padStart(2, '0')}</span>
        {film.labels.castCount}
      </p>
    </header>

    <div class="cast__grid">
      {
        film.cast.map((member, index) => (
          <article
            class="cast-card"
            data-reveal
            style={`--reveal-delay: ${Math.min(index * 60, 300)}ms`}
          >
            <div class="cast-card__top mono">
              <span class="cast-card__index">{member.id}</span>
              <span class="cast-card__plus" aria-hidden="true">+</span>
            </div>

            <MediaPlaceholder
              src={member.photo}
              alt={member.photoAlt}
              dimensions="900 × 1200 px"
              ratio="3-4"
              class="cast-card__media"
            />

            <div class="cast-card__body">
              <h3 class="cast-card__character">{member.character}</h3>
              <p class="cast-card__actor mono">
                <span>{film.labels.actorLabel}:</span> {member.actor}
              </p>
              <p class="cast-card__description">{member.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cast {
    background:
      linear-gradient(to bottom, transparent, rgba(17, 19, 15, 0.35) 45%, transparent);
  }

  .cast__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .cast__head-main {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.4rem);
  }

  .cast__count {
    padding-bottom: 0.35rem;
    color: var(--smoke);
    font-size: 0.64rem;
    white-space: nowrap;
  }

  .cast__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 2.5vw, 2.25rem);
    row-gap: clamp(2.5rem, 5vw, 3.75rem);
  }

  .cast-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cast-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.65rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line-strong);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .cast-card__index {
    color: var(--signal);
  }

  .cast-card__plus {
    color: var(--smoke);
    font-size: 0.85rem;
    line-height: 1;
  }

  .cast-card :global(.media) {
    border-color: var(--line);
  }

  .cast-card :global(.media img) {
    filter: grayscale(1) contrast(1.04);
    transition:
      filter 0.55s var(--ease),
      transform 0.55s var(--ease);
  }

  .cast-card:hover :global(.media img),
  .cast-card:focus-within :global(.media img) {
    filter: grayscale(0) contrast(1);
    transform: scale(1.02);
  }

  .cast-card__body {
    display: grid;
    gap: 0.45rem;
    padding-top: 1rem;
  }

  .cast-card__character {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.35rem);
    letter-spacing: -0.015em;
    line-height: 0.92;
    text-transform: uppercase;
    transition: color 0.25s var(--ease);
  }

  .cast-card:hover .cast-card__character {
    color: var(--signal);
  }

  .cast-card__actor {
    color: var(--smoke);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .cast-card__actor span {
    color: rgba(215, 162, 62, 0.8);
  }

  .cast-card__description {
    max-width: 34ch;
    color: var(--smoke);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  @media (max-width: 1023px) {
    .cast__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .cast__grid {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
    }

    .cast__head {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.9rem;
    }

    .cast__count {
      padding-bottom: 0;
    }

    .cast-card__description {
      max-width: 46ch;
    }
  }
</style>
