---
import { film } from '../content/film';
import MediaPlaceholder from './MediaPlaceholder.astro';
---

<section class="production section" id="produccion" aria-labelledby="production-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">
        <span class="eyebrow__num">03</span>
        <span>/</span>
        <span>Producción</span>
        <span class="eyebrow__rule"></span>
        <span>{String(film.production.length).padStart(2, '0')} {film.labels.stageCount}</span>
      </p>
      <h2 class="section-title" id="production-title">{film.labels.sectionProduction}</h2>
    </header>
  </div>

  <div class="strip">
    <span class="strip__perf" aria-hidden="true"></span>

    <div class="strip__track container">
      {
        film.production.map((stage, index) => (
          <article
            class="stage"
            data-reveal
            style={`--reveal-delay: ${Math.min(index * 80, 240)}ms`}
          >
            <MediaPlaceholder
              src={stage.photo}
              alt={stage.photoAlt}
              dimensions="1600 × 1067 px"
              ratio="3-2"
            />
            <div class="stage__meta">
              <p class="stage__num mono">{stage.number}</p>
              <h3 class="stage__title">{stage.title}</h3>
              <p class="stage__description">{stage.description}</p>
            </div>
          </article>
        ))
      }
    </div>

    <span class="strip__perf strip__perf--bottom" aria-hidden="true"></span>
  </div>
</section>

<style>
  .strip {
    position: relative;
    background: var(--coal);
    border-block: 1px solid var(--line);
    padding-block: clamp(2.25rem, 4vw, 3.25rem);
    overflow: hidden;
  }

  .strip__perf {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 11px;
    background-image: radial-gradient(
      ellipse 6px 4px at 13px 5px,
      var(--ink) 97%,
      transparent 100%
    );
    background-size: 26px 11px;
    border-bottom: 1px solid rgba(233, 227, 213, 0.06);
  }

  .strip__perf--bottom {
    top: auto;
    bottom: 0;
    border-bottom: 0;
    border-top: 1px solid rgba(233, 227, 213, 0.06);
  }

  .strip__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .stage {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .stage + .stage {
    padding-left: clamp(1.25rem, 2.5vw, 2.25rem);
    border-left: 1px solid var(--line);
  }

  .stage :global(.media img) {
    filter: grayscale(0.85);
    transition:
      filter 0.55s var(--ease),
      transform 0.55s var(--ease);
  }

  .stage:hover :global(.media img) {
    filter: grayscale(0);
    transform: scale(1.02);
  }

  .stage__meta {
    display: grid;
    gap: 0.45rem;
    padding-top: 0.9rem;
  }

  .stage__num {
    color: var(--signal);
    font-size: 0.64rem;
  }

  .stage__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.55rem, 1.25rem + 0.9vw, 2.1rem);
    letter-spacing: -0.01em;
    line-height: 1;
    text-transform: uppercase;
  }

  .stage__description {
    max-width: 30ch;
    color: var(--smoke);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (max-width: 859px) {
    .strip__track {
      display: flex;
      gap: 1.25rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
      scrollbar-color: var(--line-strong) transparent;
      padding-bottom: 0.85rem;
    }

    .stage {
      flex: 0 0 min(82vw, 22rem);
      scroll-snap-align: start;
    }

    .stage + .stage {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 859px) and (min-width: 640px) {
    .stage {
      flex-basis: min(58vw, 24rem);
    }
  }
</style>
